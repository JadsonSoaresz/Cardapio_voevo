# Copie para .env e preencha para usar o Supabase também no seu computador (npm run start:env).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase > Project Settings > API (ou "Connect"): Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase > Project Settings > API Keys: a chave SECRETA (service_role ou sb_secret_...).
# Nunca use a chave "anon"/"publishable" aqui, e nunca coloque esta chave no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Senha inicial do painel (só é usada quando PASSWORD_REQUIRED = true em lib/app.js).
ADMIN_PASSWORD=
